# Copy to .env and fill with long random values. Never commit .env.
# Master key MUST start with sk-. Do not give it to microservices.
LITELLM_MASTER_KEY=sk-replace-me
LITELLM_SALT_KEY=replace-me-never-rotate-after-storing-provider-keys
# Hosted Postgres (RDS, Lightsail DB, Cloud SQL, etc.). Use the public or
# VPC hostname, not @db. Percent-encode special characters in the password.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Bootstrap Admin UI login only. Create a real proxy_admin, then enable
# disable_env_credential_login in config.yaml.
UI_USERNAME=adeeb.mirza@syncques.com
UI_PASSWORD=replace-me

# Public origin (scheme + host). Used for Admin UI links and SSO callbacks.
PROXY_BASE_URL=https://gateway.syncques.in
CERTBOT_EMAIL=adeebmirzam3@gmail.com
